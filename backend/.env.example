# ─────────────────────────────────────────────────────────────────
#  InstaPilot AI — Backend Environment Variables Template
#  Copy this file to backend/.env and fill in your actual values.
# ─────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────────
# Generate a secure key, e.g., with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_KEY_MIN_32_CHARS

# ── Database ──────────────────────────────────────────────────────
# SQLite (local dev):
DATABASE_URL=sqlite:///./instapilot.db

# ── Meta / Instagram ──────────────────────────────────────────────
# Create your app at: https://developers.facebook.com/
META_APP_ID=
META_APP_SECRET=
# This MUST match the redirect URI whitelisted in your Meta App settings
META_REDIRECT_URI=http://localhost:8000/integrations/instagram/callback

# ── OpenAI ────────────────────────────────────────────────────────
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Frontend ──────────────────────────────────────────────────────
# Replace with your LAN IP for mobile testing (e.g., http://192.168.1.100:5173)
FRONTEND_URL=http://localhost:5173
